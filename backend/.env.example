# 复制为 backend/.env（已被 .gitignore 忽略）。已存在的环境变量优先于本文件。

# 必填：登录 token 签名密钥，至少 32 字符。生成：php -r "echo bin2hex(random_bytes(32));"
OPENHUNTER_TOKEN_SECRET=

# 数据库：sqlite（默认，零配置）或 mysql（8.x）
OPENHUNTER_DB_DRIVER=sqlite
# OPENHUNTER_DB_PATH=/var/lib/openhunter/openhunter.db
# OPENHUNTER_DB_HOST=127.0.0.1
# OPENHUNTER_DB_PORT=3306
# OPENHUNTER_DB_NAME=openhunter
# OPENHUNTER_DB_USER=openhunter
# OPENHUNTER_DB_PASS=
# OPENHUNTER_DB_PASS_FILE=/run/secrets/db_pass

# 业务时区与相对 UTC 的小时数（SQLite 的 datetime('now','+N hours') 用它）
OPENHUNTER_TIMEZONE=Asia/Jakarta
OPENHUNTER_UTC_OFFSET=7
OPENHUNTER_DEFAULT_CURRENCY=IDR

# 推荐信抬头（均可空）
OPENHUNTER_BRAND_NAME=OpenHunter
# OPENHUNTER_BRAND_NAME_EN=
# OPENHUNTER_BRAND_SLOGAN=
# OPENHUNTER_BRAND_LOGO=/path/to/logo.png

# 接口跨域白名单；前端与后端同域部署时可以不配
# OPENHUNTER_CORS_ORIGIN=https://hunter.example.com
